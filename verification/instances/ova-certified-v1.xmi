    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ova="https://uet-dse.org/ocl/validation-algebra/1.0"
    languageVersion="ova-certified-v1" certificationProfile="OCL_VAL_FINITE_SET_V1">
  <invariants invariantId="inv_person_name" name="PersonNameInvariant"
      contextClassName="Person" stage="SEMANTIC" producerVersion="semantic-ir-v1">
