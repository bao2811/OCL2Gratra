<?xml version="1.0" encoding="UTF-8"?>
<nva:NvaModule xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:nva="https://uet-dse.org/nva/1.0"
    languageVersion="nva-certified-v1" certificationProfile="OCL_VAL_FINITE_SET_V1">
  <invariants invariantId="nva_inv_person_true" name="PersonTrueInvariant"
      contextClassName="Person" producerVersion="t-norm-v1">
