context Buyer inv validLinkingMakesBy:
  self.purchase->forAll( c:Purchase | (c.snapshotPurchase = self.snapshotBuyer) )

context Buyer inv validSnapshotLinking:
  (self.succBuyer.isDefined() implies (self.succBuyer.snapshotBuyer = self.snapshotBuyer.succ()))

context LotteryDraw inv validSnapshotLinking:
  (self.succLotteryDraw.isDefined() implies (self.succLotteryDraw.snapshotLotteryDraw = self.snapshotLotteryDraw.succ()))

context OperationCall inv assocClassBehavior:
  (((self.pred->size() = 1) and (self.succ->size() = 1)) and OperationCall.allInstances()->forAll( op:OperationCall | (((self.pred = op.pred) and (self.succ = op.succ)) implies (self = op)) ))

context Purchase inv validLinkingBuysFrom:
  (self.lotteryDraw.isDefined() implies (self.snapshotPurchase = self.lotteryDraw.snapshotLotteryDraw))

context Purchase inv validSnapshotLinking:
  (self.succPurchase.isDefined() implies (self.succPurchase.snapshotPurchase = self.snapshotPurchase.succ()))

context Snapshot inv cycleFree:
  Set{self.succ()}->closure( s:Snapshot | s.succ() )->excludes(self)

context Snapshot inv oneFilmstrip:
  ((Snapshot.allInstances()->select( s:Snapshot | s.pred().isUndefined() )->size() = 1) and (Snapshot.allInstances()->select( s:Snapshot | s.succ().isUndefined() )->size() = 1))

