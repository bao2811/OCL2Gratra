context BuyLotteryTicket inv validLinkingBuyLotteryTicket_buyer:
  (self.buyer.isDefined() implies (self.snapshotBuyLotteryTicket = self.buyer.snapshotBuyer))

context BuyLotteryTicket inv validLinkingBuyLotteryTicket_lotteryDraw:
  (self.lotteryDraw.isDefined() implies (self.snapshotBuyLotteryTicket = self.lotteryDraw.snapshotLotteryDraw))

context BuyLotteryTicket inv validLinkingBuyLotteryTicket_lotteryDraws:
  self.lotteryDraws->forAll( c:LotteryDraw | (c.snapshotLotteryDraw = self.snapshotBuyLotteryTicket) )

context BuyLotteryTicket inv validLinkingBuyLotteryTicket_purchase:
  (self.purchase.isDefined() implies (self.snapshotBuyLotteryTicket = self.purchase.snapshotPurchase))

context BuyLotteryTicket inv validSnapshotLinking:
  (self.succBuyLotteryTicket.isDefined() implies (self.succBuyLotteryTicket.snapshotBuyLotteryTicket = self.snapshotBuyLotteryTicket.succ()))

context BuyLotteryTicketOpC inv aSelfDefined:
  self.aSelf.isDefined()

context BuyLotteryTicketOpC inv aSelfInPred:
