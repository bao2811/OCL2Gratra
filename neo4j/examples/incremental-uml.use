model LotteryTicketModel


class step3_act_BuyLotteryTicketOpC < BuyLotteryTicketOpC
end

composition SnapshotPurchase between
  Snapshot[1] role snapshotPurchase
  Purchase[*]
end

aggregation PredSuccLotteryDraw between
  LotteryDraw[0..1] role predLotteryDraw
  LotteryDraw[0..1] role succLotteryDraw
end

association Filmstrip between
  Snapshot[0..1] role pred
  Snapshot[0..1] role succ
  OperationCall[0..1]
end

association BuyLotteryTicket_lotteryDraws between
  BuyLotteryTicket[0..1] role buyLotteryTicketlotterydraws
  LotteryDraw[*] role lotteryDraws
end

association BuyLotteryTicket_purchase between
  BuyLotteryTicket[0..1] role buyLotteryTicketPurchase
  Purchase[0..1]
end

class step4_sys_BuyLotteryTicketOpC < BuyLotteryTicketOpC
end

abstract class OperationCall
operations
  pred() : Snapshot =
    if (self.pred->size() = 1) then self.pred->any( $elem0:Snapshot | true ) else null endif
  succ() : Snapshot =
    if (self.succ->size() = 1) then self.succ->any( $elem0:Snapshot | true ) else null endif
end

abstract class BuyLotteryTicketOpC < OperationCall
attributes
  aSelf : BuyLotteryTicket
end

class match_step5_act_BuyLotteryTicketOpC < BuyLotteryTicketOpC
end

class BuyLotteryTicket
attributes
  curStep : String
  lotteryDrawId : Integer
  lotteryDrawIds : Set(Integer)
  matchedStep : String
  purchaseTotal : Integer
  ticketPrice : Integer
  ticketQuantity : Integer
operations
  enter_BuyLotteryTicket() : Boolean =
    (((not self.buyer.isUndefined() and not self.lotteryDraw.isUndefined()) and (self.lotteryDraw.availableTickets > 0)) and (self.curStep = 's0'))
  exit_BuyLotteryTicket() : Boolean =
    (not self.purchase.isUndefined() and self.isFinalStep())
  isFinalStep() : Boolean =
    (self.curStep = 'step6_sys')
  match_step3_act()
  match_step5_act()
  step1_act()
  step2_sys()
  step3_act()
  step4_sys()
  step5_act()
  step6_sys()
end

composition SnapshotBuyer between
  Snapshot[1] role snapshotBuyer
  Buyer[*]
end

class step1_act_BuyLotteryTicketOpC < BuyLotteryTicketOpC
end

association BuyLotteryTicket_buyer between
  BuyLotteryTicket[0..1] role buyLotteryTicketBuyer
  Buyer[0..1]
end

aggregation PredSuccBuyLotteryTicket between
  BuyLotteryTicket[0..1] role predBuyLotteryTicket
  BuyLotteryTicket[0..1] role succBuyLotteryTicket
end

composition SnapshotLotteryDraw between
  Snapshot[1] role snapshotLotteryDraw
  LotteryDraw[*]
end

composition SnapshotBuyLotteryTicket between
  Snapshot[1] role snapshotBuyLotteryTicket
  BuyLotteryTicket[*]
end

class step6_sys_BuyLotteryTicketOpC < BuyLotteryTicketOpC
end

class Snapshot
operations
  copy() : Snapshot
    begin
      declare s : Snapshot;
      s := new Snapshot;
      for cl in self.buyLotteryTicket do
        declare x : BuyLotteryTicket;
        x := new BuyLotteryTicket;
        insert (cl,x) into PredSuccBuyLotteryTicket;
        insert (s,x) into SnapshotBuyLotteryTicket;
      end;
      for cl in self.buyer do
        declare x : Buyer;
        x := new Buyer;
        insert (cl,x) into PredSuccBuyer;
        insert (s,x) into SnapshotBuyer;
      end;
      for cl in self.lotteryDraw do
        declare x : LotteryDraw;
        x := new LotteryDraw;
        insert (cl,x) into PredSuccLotteryDraw;
        insert (s,x) into SnapshotLotteryDraw;
      end;
      ;
      for cl in self.purchase do
        declare x : Purchase;
        x := new Purchase;
        insert (cl,x) into PredSuccPurchase;
        insert (s,x) into SnapshotPurchase;
      end;
      for cl in s.buyLotteryTicket do
        cl.curStep := cl.predBuyLotteryTicket.curStep;
        cl.lotteryDrawId := cl.predBuyLotteryTicket.lotteryDrawId;
        cl.lotteryDrawIds := cl.predBuyLotteryTicket.lotteryDrawIds;
        cl.matchedStep := cl.predBuyLotteryTicket.matchedStep;
        cl.purchaseTotal := cl.predBuyLotteryTicket.purchaseTotal;
        cl.ticketPrice := cl.predBuyLotteryTicket.ticketPrice;
        cl.ticketQuantity := cl.predBuyLotteryTicket.ticketQuantity;
      end;
      for cl in s.buyer do
        cl.id := cl.predBuyer.id;
      end;
      for cl in s.lotteryDraw do
        cl.availableTickets := cl.predLotteryDraw.availableTickets;
        cl.drawNumber := cl.predLotteryDraw.drawNumber;
        cl.id := cl.predLotteryDraw.id;
        cl.ticketPrice := cl.predLotteryDraw.ticketPrice;
      end;
      for cl in s.purchase do
        cl.id := cl.predPurchase.id;
        cl.quantity := cl.predPurchase.quantity;
        cl.totalCost := cl.predPurchase.totalCost;
      end;
      for cl in self.buyLotteryTicket do
        if not cl.purchase.isUndefined then
          insert (cl.succBuyLotteryTicket,cl.purchase.succPurchase) into BuyLotteryTicket_purchase
        end;
        if not cl.lotteryDraw.isUndefined then
          insert (cl.succBuyLotteryTicket,cl.lotteryDraw.succLotteryDraw) into BuyLotteryTicket_lotteryDraw
        end;
        if not cl.buyer.isUndefined then
          insert (cl.succBuyLotteryTicket,cl.buyer.succBuyer) into BuyLotteryTicket_buyer
        end;
        if not cl.lotteryDraws->isEmpty then
          for elem in cl.lotteryDraws do
            insert (cl.succBuyLotteryTicket,elem.succLotteryDraw) into BuyLotteryTicket_lotteryDraws
          end
        end;
      end;
      for cl in self.buyer do
        if not cl.purchase->isEmpty then
          for elem in cl.purchase do
            insert (cl.succBuyer,elem.succPurchase) into MakesBy
          end
        end;
      end;
      for cl in self.lotteryDraw do
        if not cl.purchase->isEmpty then
          for elem in cl.purchase do
            insert (elem.succPurchase,cl.succLotteryDraw) into BuysFrom
          end
        end;
      end;
      result := s;
    end
  pred() : Boolean =
    true
  succ() : Snapshot =
    if (self.succ->size() = 1) then self.succ->any( $elem0:Snapshot | true ) else null endif
end

