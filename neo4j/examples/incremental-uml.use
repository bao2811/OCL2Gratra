class LotteryDraw
attributes
  id : Integer
  drawNumber : Integer
  ticketPrice : Integer
  availableTickets : Integer
end

class Buyer
attributes
  id : Integer
end

class Purchase
attributes
  id : Integer
  quantity : Integer
  totalCost : Integer
end

association BuysFrom between
  Purchase[*]
  LotteryDraw[1]
end

association MakesBy between
  Buyer[1]
  Purchase[*]
end

