rule compStateNest
checkSource(
  sc:Statechart
  cps:CompState
  (sc,cps):OwnsState
  [cps.isConcurr=false]
){
  s:CompState
  (sc,s):OwnsState
  (cps,s):ContainsState
  [s.name<>oclUndefined(String)]
  [s.isConcurr=false]
}checkTarget(
  eha:EHA
  aut:AutH
  (eha,aut):OwnsAutH
){
  sH:StateH
  aut1:AutH
  (aut,sH):ContainsStateH
  (sH,aut1):RefiningAutH
  (eha,aut1):OwnsAutH  
  [aut1.name<>oclUndefined(String)]
}checkCorr(
  (sc,eha) as (sc,eha) in s2e:SC2EHA
  (cps,aut) as (sc,eha) in s2a:St2Aut
  St2Aut:[self.eha.name=self.sc.name]
){
  ((State)s,sH) in s2sH:S2SH
  (s,aut1) as (sc,eha) in s2a1:St2Aut
  S2SH:[self.eha.name=self.sc.name]
  St2Aut:[self.eha.name=self.sc.name]
}end

rule transitToSimp
checkSource(
  sc:Statechart
  s1:State
  s2:State
){
  tr:Trans
  e:Event
  (tr,s1):TransFrom
  (tr,s2):TransTo
  (sc,tr):OwnsTrans
  (tr,e):Trigger
}checkTarget(
  eha:EHA
  sH1:StateH
  sH2:StateH
  aut:AutH
  (eha,aut):OwnsAutH
  (aut,sH1):ContainsStateH
  (aut,sH2):ContainsStateH
){
  trH:TransH
  eH:EventH
  (trH,sH1):TransFromH
  (trH,sH2):TransToH
  (aut,trH):ContainsTransH
  (trH,eH):TriggerH
}checkCorr(
  (sc,eha) as (sc,eha) in s2e:SC2EHA
  (s1,sH1) as (sc,eha) in s2sH1:S2SH
  (s2,sH2) in s2sH2:S2SH
){}
end

rule transitToComp
checkSource(
  sc:Statechart
  s1:State
  s2:CompState
  s3:State
  (sc,s1):OwnsState
  (sc,s2):OwnsState
  (s2,s3):ContainsState
  [s2.isConcurr=false]
){
  tr:Trans
  e:Event
  (tr,s1):TransFrom
  (tr,s2):TransTo
  (sc,tr):OwnsTrans
  (tr,e):Trigger
}checkTarget(
  eha:EHA
  sH1:StateH
  sH2:StateH
  sH3:InitH
  aut:AutH
  (eha,aut):OwnsAutH
  (aut,sH1):ContainsStateH
  (aut,sH2):ContainsStateH
){
  trH:TransH
  eH:EventH
  (trH,sH1):TransFromH
  (trH,sH2):TransToH
  (aut,trH):ContainsTransH
  (trH,sH3):TargetDet
  (trH,eH):TriggerH
}checkCorr(
  (sc,eha) as (sc,eha) in s2e:SC2EHA
  (s1,sH1) as (sc,eha) in s2sH1:S2SH
  ((State)s2,sH2) in s2sH2:S2SH
  (s3,(StateH)sH3) in s2sH3:S2SH
){}
end

rule transitToConcurr
checkSource(
  sc:Statechart
  s1:State
  s2:CompState
  s3:State
  s4:State
  (sc,s1):OwnsState
  (sc,s2):OwnsState
  (sc,s3):OwnsState
  (sc,s4):OwnsState
  [s2.isConcurr=true]
  [s2.content->includes(s3.container)]
  [s2.content->includes(s4.container)]
){
  tr:Trans
  e:Event
  (tr,s1):TransFrom
  (tr,s2):TransTo
  (sc,tr):OwnsTrans
  (tr,e):Trigger
}checkTarget(
  eha:EHA
  sH1:StateH
  sH2:StateH
  sH3:InitH
  sH4:InitH
  aut:AutH
  (eha,aut):OwnsAutH
  (aut,sH1):ContainsStateH
  (aut,sH2):ContainsStateH
){
  trH:TransH
  eH:EventH
  (trH,sH1):TransFromH
  (trH,sH2):TransToH
  (aut,trH):ContainsTransH
  (trH,sH3):TargetDet
  (trH,sH4):TargetDet
  (trH,eH):TriggerH
}checkCorr(
  (sc,eha) as (sc,eha) in s2e:SC2EHA
  (s1,sH1) as (sc,eha) in s2sH1:S2SH
  ((State)s2,sH2) in s2sH2:S2SH
  (s3,(StateH)sH3) in s2sH3:S2SH
  (s4,(StateH)sH4) in s2sH4:S2SH
){}
end

