transformation sc2eha
direction forward

rule initTop
checkSource(  
){
  sc:Statechart
  initS:Init
  s:SimpState
  tr:Trans
  (tr,initS):TransFrom
  (tr,s):TransTo
  (sc,s):OwnsState
  (sc,tr):OwnsTrans
  (sc,initS):OwnsState
  [initS.name='']
  [s.name<>oclUndefined(String)]
}checkTarget(
){  
  eha:EHA
  top:InitH
  aut:AutH  
  sH:InitH
  (eha,top):InitState
  (top,aut):RefiningAutH
  (eha,aut):OwnsAutH
  (aut,sH):ContainsStateH
  [aut.name='']
}checkCorr(
){
  (sc,eha) as (sc,eha) in s2e:SC2EHA
  ((State)initS,(StateH)top) as (sc,eha) in i2i:S2SH
  ((State)s,(StateH)sH) in s2sH:S2SH
  S2SH:[self.eha.name=self.sc.name]
}end

rule initNest
checkSource(
  sc:Statechart
  cps:CompState
){
  initS:Init
  s:SimpState
  tr:Trans
  (tr,initS):TransFrom
  (tr,s):TransTo
  (sc,s):OwnsState
  (sc,tr):OwnsTrans
  (cps,s):ContainsState
  [initS.name='']
  [s.name<>oclUndefined(String)]
}checkTarget(
  eha:EHA
  aut:AutH
  (eha,aut):OwnsAutH
){
  sH:InitH
  (aut,sH):ContainsStateH
}checkCorr(
  (sc,eha) as (sc,eha) in s2e:SC2EHA
  (cps,aut) as (sc,eha) in s2a:St2Aut
){
  ((State)s,(StateH)sH) in s2sH:S2SH
  S2SH:[self.eha.name=self.sc.name]
}end

rule simpStateTop
checkSource(
  sc:Statechart
){
  s:SimpState
  (sc,s):OwnsState
  [s.name<>oclUndefined(String)]
  [s.container=oclUndefined(CompState)]
}checkTarget(
  eha:EHA
  aut:AutH
  (eha,aut):OwnsAutH
  [aut.refined=eha.top]
){
  sH:StateH
  (aut,sH):ContainsStateH
}checkCorr(
  (sc,eha) as (sc,eha) in s2e:SC2EHA
){
  ((State)s,sH) as (sc,eha) in s2sH:S2SH 
  S2SH:[self.eha.name=self.sc.name] 
}end

rule simpStateNest
checkSource(
  sc:Statechart
  cps:CompState
){
  s:SimpState
  (sc,s):OwnsState
  (cps,s):ContainsState
  [s.name<>oclUndefined(String)]
}checkTarget(
  eha:EHA
  aut:AutH
  (eha,aut):OwnsAutH
){
  sH:StateH
  (aut,sH):ContainsStateH
}checkCorr(
  (sc,eha) as (sc,eha) in s2e:SC2EHA
  (cps,aut) as (sc,eha) in s2a:St2Aut
){
  ((State)s,sH) in s2sH:S2SH  
  S2SH:[self.eha.name=self.sc.name]
}end

rule concurrStateTop
checkSource(
  sc:Statechart
){
  s:CompState
  s1:CompState
  s2:CompState
  (sc,s):OwnsState
  (sc,s1):OwnsState
  (sc,s2):OwnsState
  (s,s1):ContainsState
  (s,s2):ContainsState
  [s.name<>oclUndefined(String)]
  [s1.name<>oclUndefined(String)]
  [s2.name<>oclUndefined(String)]
  [s.isConcurr=true]
  [s.container=oclUndefined(CompState)]
  [s1.isConcurr=false]
  [s2.isConcurr=false]
}checkTarget(
  eha:EHA
  aut:AutH
  (eha,aut):OwnsAutH
  [aut.refined=eha.top]
){
  sH:StateH
  aut1:AutH
  aut2:AutH
  (eha,aut1):OwnsAutH
  (eha,aut2):OwnsAutH
  (aut,sH):ContainsStateH
  (sH,aut1):RefiningAutH
  (sH,aut2):RefiningAutH
}checkCorr(
  (sc,eha) as (sc,eha) in s2e:SC2EHA
){
  (s1,aut1) as (sc,eha) in s2a1:St2Aut
  (s2,aut2) as (sc,eha) in s2a2:St2Aut
  ((State)s,sH) as (sc,eha) in s2sH:S2SH  
  S2SH:[self.eha.name=self.sc.name]
  St2Aut:[self.eha.name=self.sc.name]
}end

