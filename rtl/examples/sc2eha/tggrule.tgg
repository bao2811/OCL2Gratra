rule transitUpSimp
checkSource(
  sc:Statechart
  s1:State
  s2:State
  s3:CompState
  (sc,s1):OwnsState
  (sc,s2):OwnsState
  [s3.allChilds()->includes(s1)]
){
  tr:Trans
  e:Event
  (tr,s1):TransFrom
  (tr,s2):TransTo
  (sc,tr):OwnsTrans
  (tr,e):Trigger
}checkTarget(
  eha:EHA
  sH1:StateH
  sH2:StateH
  sH3:StateH
  aut:AutH
  (eha,aut):OwnsAutH
  (aut,sH2):ContainsStateH
  (aut,sH3):ContainsStateH
){
  trH:TransH
  eH:EventH
  (trH,sH3):TransFromH
  (trH,sH2):TransToH
  (aut,trH):ContainsTransH
  (trH,sH1):SrcRest
  (trH,eH):TriggerH
}checkCorr(
  (sc,eha) as (sc,eha) in s2e:SC2EHA
  (s1,sH1) as (sc,eha) in s2sH1:S2SH
  (s2,sH2) in s2sH2:S2SH
  ((State)s3,sH3) in s2sH3:S2SH
){}
end
