transformation Families2Persons
direction forward

// Expanded TGG derived from examples/families2person/src/*.msl.
// This file keeps the simple parser-friendly shape of F2PForward.tgg, while
// preserving the rule split from the EMSL source:
// - Families2Persons
// - FamilyMember2Person
// - ExistingFamily2Person
// - Father/Mother/Son/Daughter variants for new and existing families
//
// Notes for the current runtime:
// - "abstract" and "forbid" are documented as comments because the current
//   workspace loader only executes rule/checkSource/checkTarget/checkCorr.
// - Operational forward support is currently hardcoded for Families2Persons.
//   This file is intended as the richer rule model to implement against next.

rule Families2Persons
checkSource(
){
	fr: FamilyRegister
}checkTarget(
){
	pr: PersonRegister
}checkCorr(
){
	(fr, pr) as (fr, pr) in fr2pr:FR2PR
}
end

// abstract tripleRule FamilyMember2Person : Families2Persons
rule FamilyMember2Person
checkSource(
	fr: FamilyRegister
	(fr, fm): FamilyRegistration
	[fm.name <> Undefined]
){
	fm: Family
	member: FamilyMember
	[member.name <> Undefined]
}checkTarget(
	pr: PersonRegister
){
	person: Person
	(pr, person): PersonRegistration
}checkCorr(
	(fr, pr) as (fr, pr) in fr2pr:FR2PR
){
	(member, person) as (member, person) in fm2p:FamilyMemberToPerson
	FamilyMemberToPerson:[self.person.name.split(', ')->at(2) = self.member.name]
	`self.person.name := self.member.name`
	``
}
end

// abstract tripleRule ExistingFamily2Person : Families2Persons -> FamilyMember2Person
rule ExistingFamily2Person
checkSource(
	fr: FamilyRegister
	(fr, fm): FamilyRegistration
	[fm.name <> Undefined]
){
	fm: Family
}checkTarget(
	pr: PersonRegister
){
}checkCorr(
	(fr, pr) as (fr, pr) in fr2pr:FR2PR
){
}
end

rule FatherToMale
checkSource(
	fr: FamilyRegister
	[fm.name <> Undefined]
){
	fm: Family
	father: FamilyMember
	(fr, fm): FamilyRegistration
	(fm, father): Father
	[father.name <> Undefined]
}checkTarget(
	pr: PersonRegister
){
	mp: Male
	(pr, mp): PersonRegistration
}checkCorr(
	(fr, pr) as (fr, pr) in fr2pr:FR2PR
){
	(father, mp) as (father, mp) in fm2p:FamilyMemberToPerson
	(father, mp) as (f, mp) in f2mp:F2MP
	(fm*, mp) as (fm, mp) in fm2mp:FM2MP
	F2MP:[self.mp.name.split(', ')->at(2) = self.f.name]
	`self.mp.name := self.f.familyFather.name + ', ' + self.f.name`
	``
	FM2MP:[self.mp.name.split(', ')->at(1)= self.fm.name]
	``
	``
}
end

rule FatherOfExistingFamilyToMale
// forbid src(existingFather):
// pattern existingFather { f : Family { -father->existingFather } existingFather : FamilyMember }
checkSource(
	fr: FamilyRegister
	fm: Family
	(fr, fm): FamilyRegistration
	[fm.name <> Undefined]
){
	father: FamilyMember
	(fm, father): Father
	[father.name <> Undefined]
}checkTarget(
	pr: PersonRegister
){
	mp: Male
	(pr, mp): PersonRegistration
}checkCorr(
	(fr, pr) as (fr, pr) in fr2pr:FR2PR
){
	(father, mp) as (father, mp) in fm2p:FamilyMemberToPerson
	(father, mp) as (f, mp) in f2mp:F2MP
	(fm*, mp) as (fm, mp) in fm2mp:FM2MP
	F2MP:[self.mp.name.split(', ')->at(2) = self.f.name]
	`self.mp.name := self.f.familyFather.name + ', ' + self.f.name`
	``
	FM2MP:[self.mp.name.split(', ')->at(1)= self.fm.name]
	``
	``
}
end

