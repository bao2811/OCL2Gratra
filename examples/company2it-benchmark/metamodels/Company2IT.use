model Company2IT

class BenchmarkRoot
end

class Company
attributes
    name : String
end

class Person
attributes
    age : Integer
    firstName : String
    salary : Integer
end

association RootCompanies between
    BenchmarkRoot [1] role root
    Company [*] role companies
end

association CompanyEmployee between
    Company [*] role employer
    Person [*] role employee
end

association CompanyManager between
    Company [*] role managedCompany
    Person [1] role manager
end
