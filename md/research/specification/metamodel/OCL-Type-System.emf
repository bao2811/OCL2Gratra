@namespace(uri="https://uet-dse.org/ocl/type-system/1.0", prefix="ocltypes")
@GenModel(documentation="Concrete UML/OCL type-conformance model shared by certified binding, normalization, and coercion witnesses. It mirrors the production OclTypeBinding shapes without expanding the currently certified expression grammar.")
package ocltypes;

enum ScalarTypeKind {
  VOID;
  OCL_ANY;
  BOOLEAN;
  INTEGER;
  REAL;
  STRING;
  UNLIMITED_NATURAL;
  ENUM;
}

enum CollectionTypeKind {
  COLLECTION;
  SET;
  BAG;
  SEQUENCE;
  ORDERED_SET;
}

enum ConformanceRuleKind {
  REFLEXIVE;
  VOID_BOTTOM;
  OCL_ANY_TOP;
  INTEGER_TO_REAL;
  UNLIMITED_NATURAL_TO_INTEGER;
  UML_GENERALIZATION;
  COLLECTION_COVARIANCE;
  GENERIC_COLLECTION;
}

class OclTypeSystem {
  attr String[1] profile = "OCL_TYPE_CONFORMANCE_V1";
  val UmlClassifier[*] classifiers;
  val UmlGeneralization[*] generalizations;
  val ConformanceJudgement[*] certifiedJudgements;
}

class UmlClassifier {
  id attr String[1] qualifiedName;
}

class UmlGeneralization {
  ref UmlClassifier[1] child;
  ref UmlClassifier[1] parent;
}

abstract class OclType {
  id attr String[1] typeId;
}

class ScalarType extends OclType {
  attr ScalarTypeKind[1] kind;
  attr String typeName;
}

class ClassType extends OclType {
  ref UmlClassifier[1] classifier;
}

class CollectionType extends OclType {
  attr CollectionTypeKind[1] kind;
  val OclType[1] elementType;
}

class ConformanceJudgement {
  id attr String[1] judgementId;
  val OclType[1] actual;
  val OclType[1] declared;
  attr ConformanceRuleKind[1] rule;
  ref UmlGeneralization[*] generalizationPath;
  val ConformanceJudgement elementWitness;
}
