@namespace(uri="https://uet-dse.org/cypher/ast-bridge/1.0", prefix="cyast")
@GenModel(documentation="Optional structural bridge from CQM to a restricted Cypher AST. This metamodel is not part of the normative semantic theorem unless the AST lowering proof is discharged.")
package cyast;

enum AstBinaryOperator {
  AND;
  OR;
  EQ;
  NEQ;
  LT;
  LE;
  GT;
  GE;
  ADD;
  SUBTRACT;
  MULTIPLY;
  DIVIDE;
}

class CypherQuery {
  attr String[1] dialect = "CYPHER_5";
  val CypherClause[+] clauses;
}

abstract class CypherClause {
  attr String[1] clauseId;
}

class MatchClause extends CypherClause {
  attr boolean[1] optional = false;
  val Pattern[*] patterns;
}

class WhereClause extends CypherClause {
  val CypherExpression[1] predicate;
}

class ReturnClause extends CypherClause {
  val Projection[*] projections;
}

class Pattern {
  attr String[1] sourceAlias;
  attr String[1] relationshipType;
  attr String[1] targetAlias;
  attr String[1] direction;
}

class Projection {
  attr String[1] alias;
  val CypherExpression[1] expression;
}

abstract class CypherExpression {
  id attr String[1] nodeId;
}

class CypherVariable extends CypherExpression {
  attr String[1] name;
}

class CypherProperty extends CypherExpression {
  val CypherExpression[1] source;
  attr String[1] propertyName;
}

class CypherLiteral extends CypherExpression {
  attr String[1] lexicalValue;
}

class CypherBinary extends CypherExpression {
  attr AstBinaryOperator[1] operator;
  val CypherExpression[1] left;
  val CypherExpression[1] right;
}

class CypherNot extends CypherExpression {
  val CypherExpression[1] operand;
}

class CypherExists extends CypherExpression {
  val CypherQuery[1] subquery;
}
