@namespace(uri="https://uet-dse.org/ocl/validation-input/1.0", prefix="oclval")
@GenModel(documentation="Typed and admitted source model for OCL_VAL_FINITE_SET_V1. Every expression has resolved symbols, a static type, and a source collection type where applicable.")
package oclval;

enum ValTypeKind {
  BOOLEAN;
  INTEGER;
  REAL;
  STRING;
  OBJECT;
  SET;
  BOTTOM;
}

enum ValBinaryOperator {
  AND;
  OR;
  XOR;
  IMPLIES;
  EQ;
  NEQ;
  LT;
  LE;
  GT;
  GE;
  ADD;
  SUBTRACT;
  MULTIPLY;
  DIVIDE;
}

enum ValIteratorKind {
  EXISTS;
  FORALL;
  SELECT;
  REJECT;
  COLLECT;
}

class ValModule {
  attr String[1] languageVersion = "OCL_VAL_FINITE_SET_V1";
  val ValInvariant[*] invariants;
}

class ValInvariant {
  id attr String[1] invariantId;
  attr String[1] contextClassName;
  val ValVariable[1] selfVariable;
  val ValExpression[1] predicate;
}

class ValType {
  attr ValTypeKind[1] kind;
  attr String typeName;
  val ValType elementType;
}

abstract class ValExpression {
  id attr String[1] nodeId;
  attr String[1] staticType;
  attr String sourceCollectionType;
}

class ValVariable extends ValExpression {
  attr String[1] variableName;
  attr String[1] symbolId;
  attr String[1] declaredType;
}

class ValLiteral extends ValExpression {
  attr String[1] literalKind;
  attr String[1] lexicalValue;
}

class ValAttribute extends ValExpression {
  attr String[1] ownerClassName;
  attr String[1] attributeName;
  val ValExpression[1] source;
}

class ValNavigation extends ValExpression {
  attr String[1] associationName;
  attr String[1] associationKey;
  attr String[1] sourceClassName;
  attr String[1] targetClassName;
  val ValExpression[1] source;
  val ValExpression[*] qualifiers;
}

class ValBinary extends ValExpression {
  attr ValBinaryOperator[1] operator;
  val ValExpression[1] left;
  val ValExpression[1] right;
}

class ValIf extends ValExpression {
  val ValExpression[1] condition;
  val ValExpression[1] thenBranch;
  val ValExpression[1] elseBranch;
}

class ValLet extends ValExpression {
  attr String[1] variableName;
  attr String[1] variableType;
  val ValExpression[1] value;
  val ValExpression[1] body;
}

class ValIterator extends ValExpression {
  attr ValIteratorKind[1] kind;
  attr String[1] iteratorName;
  attr String[1] iteratorType;
  val ValExpression[1] source;
  val ValExpression[1] body;
}
