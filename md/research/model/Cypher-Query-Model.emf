@namespace(uri="https://uet-dse.org/cypher/query-model/1.0", prefix="cqm")
@GenModel(documentation="Typed, graph-bound Cypher Query Model for OCL_VAL_FINITE_SET_V1. CQM is deliberately above the concrete Cypher AST: it fixes semantic operators, physical graph bindings, invariant violation policy, and a no-duplication evaluation contract. AstLoweringContract states the independently checkable structural relation between each CQM constructor and the parsed Cypher AST.")
package cqm;

enum PlanTypeKind {
  BOOLEAN;
  INTEGER;
  REAL;
  STRING;
  NODE;
  COLLECTION;
  CLASS_REFERENCE;
  BOTTOM;
}

enum CollectionKind {
  NONE;
  COLLECTION;
  SET;
}

enum LiteralKind {
  NULL;
  BOTTOM;
  BOOLEAN;
  INTEGER;
  REAL;
  STRING;
}

enum UnaryOperator {
  NOT;
}

enum BinaryOperator {
  AND;
  OR;
  XOR;
  IMPLIES;
  EQ;
  NEQ;
  LT;
  LE;
  GT;
  GE;
  ADD;
  SUBTRACT;
  MULTIPLY;
  DIVIDE;
}

enum CallKind {
  METHOD;
  COLLECTION_OPERATION;
}

enum IteratorKind {
  EXISTS;
  FORALL;
  SELECT;
  REJECT;
  COLLECT;
  IS_UNIQUE;
}

enum PredicateMode {
  NONE;
  NORMAL;
  NEGATED;
}

enum TraversalDirection {
  OUTGOING;
  INCOMING;
  UNDIRECTED;
}

enum AttributeStorage {
  SLOT_NODE;
}

enum ViolationPolicy {
  NOT_VALIDATION_TRUE;
}

enum EvaluationPolicy {
  MATERIALIZE_REUSED_EXPRESSIONS;
}

enum CypherAstKind {
  QUERY;
  SINGLE_QUERY;
  MATCH_CLAUSE;
  WHERE_CLAUSE;
  WITH_CLAUSE;
  RETURN_CLAUSE;
  PATTERN;
  VARIABLE;
  PARAMETER;
  LITERAL;
  PROPERTY_ACCESS;
  FUNCTION_INVOCATION;
  UNARY_EXPRESSION;
  BINARY_EXPRESSION;
  CASE_EXPRESSION;
  LIST_EXPRESSION;
  LIST_COMPREHENSION;
  REDUCE_EXPRESSION;
  ITERABLE_PREDICATE;
  EXISTS_SUBQUERY_EXPRESSION;
  COLLECT_SUBQUERY_EXPRESSION;
}

class QueryModule {
  attr String[1] languageVersion = "cqm-certified-v2";
  attr String[1] certificationProfile = "OCL_VAL_FINITE_SET_V1";
  val InvariantPlan[*] invariants;
  val AstLoweringContract[1] astLoweringContract;
}

class InvariantPlan {
  id attr String[1] planId;
  attr String[1] invariantName;
  attr String[1] contextClassName;
  attr ViolationPolicy[1] violationPolicy = "NOT_VALIDATION_TRUE";
  attr EvaluationPolicy[1] evaluationPolicy = "MATERIALIZE_REUSED_EXPRESSIONS";

  val GraphContextBinding[1] graphBinding;
  val PlanExpression[1] predicate;
}

class GraphContextBinding {
  attr String[1] profileId = "canonical-v1";
  attr String[1] modelKey;
  attr String[1] contextClassKey;
  attr String[1] objectLabel = "Object";
  attr String[1] classLabel = "UmlClass";
  attr String[1] conformanceRelationship = "ObjectInstanceOf";
  attr String[1] identityProperty = "use_id";
}

class PlanType {
  attr PlanTypeKind[1] kind;
  attr String typeName;
  attr CollectionKind[1] collectionKind = "NONE";

  val PlanType elementType;
}

abstract class PlanExpression {
  id attr String[1] nodeId;
  val PlanType[1] resultType;
}

class VariablePlan extends PlanExpression {
  attr String[1] variableName;
}

class LiteralPlan extends PlanExpression {
  attr LiteralKind[1] kind;
  attr String lexicalValue;
}

class SetPlan extends PlanExpression {
  val PlanExpression[*] elements;
}

class UnaryPlan extends PlanExpression {
  attr UnaryOperator[1] operator;
  val PlanExpression[1] operand;
}

class BinaryPlan extends PlanExpression {
  attr BinaryOperator[1] operator;
  val PlanExpression[1] left;
  val PlanExpression[1] right;
}

class IfPlan extends PlanExpression {
  val PlanExpression[1] condition;
  val PlanExpression[1] thenBranch;
  val PlanExpression[1] elseBranch;
}

class LetPlan extends PlanExpression {
  attr String[1] variableName;
  val PlanType[1] variableType;
  val PlanExpression[1] value;
  val PlanExpression[1] body;
}

class AttributeBinding {
  attr String[1] ownerClassName;
  attr String[1] attributeName;
  attr String[1] attributeKey;
  attr AttributeStorage[1] storage = "SLOT_NODE";
  attr String directProperty;
  attr String[1] slotLabel = "AttributeValue";
  attr String[1] ownerRelationship = "ObjectHasAttribute";
  attr String[1] valueProperty = "value";
}

class AttributeAccessPlan extends PlanExpression {
  val PlanExpression[1] source;
  val AttributeBinding[1] binding;
}

class NavigationBinding {
  attr String[1] associationName;
  attr String[1] associationKey;
  attr String[1] sourceClassName;
  attr String[1] targetClassName;
  attr String sourceRole;
  attr String targetRole;
  attr TraversalDirection[1] direction;
  attr String[1] relationshipTypePrefix = "Link";
  attr String[1] sourceQualifierProperty = "sourceQualifiers";
  attr String[1] targetQualifierProperty = "targetQualifiers";
}

class NavigationAccessPlan extends PlanExpression {
  val PlanExpression[1] source;
  val NavigationBinding[1] binding;
  val PlanExpression[*] qualifiers;
}

class CallPlan extends PlanExpression {
  attr CallKind[1] callKind;
  attr String[1] operationName;
  val PlanExpression[1] source;
  // Required for COLLECTION_OPERATION; absent for METHOD.
  val PlanType sourceCollectionType;
  val PlanExpression[*] arguments;
}

class IteratorPlan extends PlanExpression {
  attr IteratorKind[1] kind;
  attr String[1] iteratorName;
  val PlanType[1] iteratorType;
  val PlanExpression[1] source;
  val PlanType[1] sourceCollectionType;
  val PlanExpression[1] body;
}

class NavigationMatchPlan {
  attr String[1] targetAlias;
  attr PredicateMode[1] predicateMode = "NONE";

  val PlanExpression[1] owner;
  val NavigationAccessPlan[1] navigation;
  val PlanExpression predicate;
  val PlanType[1] targetType;
}

class ExistsSubqueryPlan extends PlanExpression {
  val NavigationMatchPlan[1] match;
}

class NotExistsSubqueryPlan extends PlanExpression {
  val NavigationMatchPlan[1] match;
}

class CountComparisonPlan extends PlanExpression {
  attr BinaryOperator[1] operator;
  attr long[1] literal;
  val NavigationMatchPlan[1] match;
}

class UniquenessPlan extends PlanExpression {
  val NavigationMatchPlan[1] match;
  val PlanExpression[1] projection;
}

class AstLoweringContract {
  attr String[1] cypherDialect;
  attr String[1] parserImplementation;
  attr boolean[1] requireIndependentParse = true;
  attr boolean[1] requireBoundedExpansion = true;
  val ConstructorAstRule[+] rules;
}

class ConstructorAstRule {
  id attr String[1] ruleId;
  attr String[1] sourceConstructor;
  attr CypherAstKind[+] requiredAstKinds;
  attr CypherAstKind[*] forbiddenAstKinds;
  attr int[1] maxCopiesPerComplexChild = 1;
  attr String[1] observationContract;
}
