@namespace(uri="https://uet-dse.org/pgmm/view/core/1.0", prefix="pgmmview")
@GenModel(documentation="Non-normative PGMM Core View used to generate the compact metamodel figure in the paper. It is a lossy projection of PGMM-CANONICAL-1 in PGMM.emf, is not a second storage contract, and must not be used to generate production persistence or proof code.")
package pgmmview;

enum ValueType {
  STRING;
  BOOLEAN;
  INTEGER;
  REAL;
  STRING_LIST;
}

class GraphSchema {
  attr String[1] name;

  val NodeType[*] nodes;
  val EdgeType[*] edges;
}

abstract class ElementType {
  attr String[1] name;

  val Property[*] properties;
  val Key[*] keys;
}

class NodeType extends ElementType {
  attr String[+] labels;
}

class EdgeType extends ElementType {
  attr String[+] physicalTypes;

  ref NodeType[1] source;
  ref NodeType[1] target;
}

class Property {
  attr String[1] name;
  attr ValueType[1] valueType;
  attr boolean required = false;
  attr boolean many = false;
}

class Key {
  attr String[1] name;
  attr boolean isUnique = true;
  attr boolean modelScoped = true;

  ref Property[+] components;
}
