@namespace(uri="https://uet-dse.org/pgmm/canonical/1.0", prefix="pgmm")
@GenModel(documentation="Normative PGMM-CANONICAL-1 source for the canonical UML-to-property-graph storage and certification profile. Generate PGMM.ecore from this file. PGMM-Core.emf is only a non-normative paper-diagram projection. Transformation traces remain external proof relations and are intentionally not represented as PGMM metaclasses.")
package pgmm;

enum GraphProjection {
  M2_SCHEMA;
  M1_INSTANCE;
  TYPING;
  REPOSITORY_CONTROL;
}

enum Direction {
  OUTGOING;
  INCOMING;
  UNDIRECTED;
}

enum AggregationKind {
  NONE;
  SHARED;
  COMPOSITE;
}

enum PGType {
  STRING;
  BOOLEAN;
  INT64;
  REAL64;
  STRING_LIST;
  INTEGER;
  NODE_REFERENCE;
  RELATIONSHIP_REFERENCE;
}

enum ProofStatus {
  CERTIFIED;
  IMPLEMENTED_UNCERTIFIED;
  EXCLUDED;
}

enum AccessorKind {
  CONTEXT;
  ALL_INSTANCES;
  DIRECT_TYPE;
  CONFORMANCE;
  ATTRIBUTE;
  NAVIGATION;
  OBJECT_IDENTITY;
}

enum ResultKind {
  SCALAR;
  PREDICATE;
  SET;
  INVARIANT_IDS;
}

enum ConstraintSeverity {
  ERROR;
  WARNING;
  INFO;
}

abstract class NamedElement {
  attr String[1] name;
  attr String documentation;
}

class PGSpecification extends NamedElement {
  attr String[1] profileId = "canonical-v1";
  attr String[1] schemaVersion = "canonical-v7.2-typed-scalars-model-isolation";
  attr ProofStatus[1] proofStatus = "CERTIFIED";

  val ModelScope[1] modelScope;
  val NodeType[*] nodeTypes;
  val RelationshipType[*] relationshipTypes;
  val KeyDefinition[*] keyDefinitions;
  val CodecDefinition[*] codecDefinitions;
  val AccessorDefinition[*] accessorDefinitions;
  val WFConstraint[*] wfConstraints;
}

class ModelScope {
  attr String[1] modelName;
  id attr String[1] modelKey;
  attr String[1] keyDelimiter = "::";
}

abstract class GraphElementType extends NamedElement {
  attr GraphProjection[1] projection;
  attr ProofStatus[1] proofStatus = "IMPLEMENTED_UNCERTIFIED";
  val PropertyDefinition[*] properties;
}

class NodeType extends GraphElementType {
  attr String[+] labels;
  attr boolean dynamicLabelsAllowed = false;
}

class RelationshipType extends GraphElementType {
  attr String[+] physicalTypes;
  attr Direction[1] direction = "OUTGOING";
  attr boolean setSemantics = true;

  val RelationshipEnd[1] sourceEnd;
  val RelationshipEnd[1] targetEnd;
}

class RelationshipEnd extends NamedElement {
  attr String roleName;
  attr int[1] lower = 0;
  attr int[1] upper = -1;
  attr boolean ~ordered = false;
  attr boolean ~unique = true;
  attr AggregationKind[1] aggregation = "NONE";

  ref NodeType[1] nodeType;
  val QualifierDefinition[*] qualifiers;
}

class QualifierDefinition extends NamedElement {
  attr int[1] index;
  attr String[1] sourceType;
  attr String[1] physicalProperty;

  ref CodecDefinition[1] codec;
}

class PropertyDefinition extends NamedElement {
  attr String[1] physicalName;
  attr PGType[1] valueType;
  attr boolean required = false;
  attr boolean multiValued = false;
  attr String defaultValue;

  ref CodecDefinition codec;
}

class KeyDefinition extends NamedElement {
  attr boolean[1] ~unique = true;
  attr boolean modelScoped = true;
  attr String[1] constructionExpression;

  ref GraphElementType[1] ownerType;
  ref PropertyDefinition[+] components;
}

class CodecDefinition extends NamedElement {
  id attr String[1] codecId;
  attr String[1] sourceType;
  attr PGType[1] storageType;
  attr String bottomToken = "v1|V";
  attr String valuePrefix;
  attr boolean[1] injective = true;
  attr String[1] decodeExpression;
}

class AccessorDefinition extends NamedElement {
  attr AccessorKind[1] kind;
  attr ResultKind[1] resultKind;
  attr String[1] cypherTemplate;
  attr boolean setSemantics = false;
  attr boolean bottomSafe = false;
  attr ProofStatus[1] proofStatus = "IMPLEMENTED_UNCERTIFIED";

  ref NodeType[*] nodeTypes;
  ref RelationshipType[*] relationshipTypes;
  ref PropertyDefinition[*] requiredProperties;
}

class WFConstraint extends NamedElement {
  id attr String[1] constraintId;
  attr ConstraintSeverity[1] severity = "ERROR";
  attr String[1] expressionLanguage = "OCL";
  attr String[1] expression;
  attr ProofStatus[1] proofStatus = "IMPLEMENTED_UNCERTIFIED";
}
