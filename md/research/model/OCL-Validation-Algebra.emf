@namespace(uri="https://uet-dse.org/ocl/validation-algebra/1.0", prefix="ova")
@GenModel(documentation="Typed, backend-independent semantic algebra for the certified finite-set OCL validation fragment OCL_VAL_FINITE_SET_V1. The same metamodel represents semantic and optimized terms; optimized-only constructors are constrained by AlgebraStage. Extended Java backend constructs are intentionally absent unless they have an admitted grammar rule and proof case.")
package ova;

enum AlgebraStage {
  SEMANTIC;
  OPTIMIZED;
}

enum TypeKind {
  BOOLEAN;
  INTEGER;
  REAL;
  STRING;
  OBJECT;
  COLLECTION;
  CLASS_REFERENCE;
  BOTTOM;
}

enum CollectionKind {
  NONE;
  COLLECTION;
  SET;
}

enum LiteralKind {
  NULL;
  BOTTOM;
  BOOLEAN;
  INTEGER;
  REAL;
  STRING;
}

enum UnaryOperator {
  NOT;
}

enum BinaryOperator {
  AND;
  OR;
  XOR;
  IMPLIES;
  EQ;
  NEQ;
  LT;
  LE;
  GT;
  GE;
  ADD;
  SUBTRACT;
  MULTIPLY;
  DIVIDE;
}

enum CallKind {
  METHOD;
  COLLECTION_OPERATION;
}

enum IteratorKind {
  EXISTS;
  FORALL;
  SELECT;
  REJECT;
  COLLECT;
  IS_UNIQUE;
}

enum NavigationDirection {
  OUTGOING;
  INCOMING;
}

enum NavigationPredicateKind {
  EXISTS;
  NOT_EXISTS;
  FORALL;
}

class ValidationModule {
  attr String[1] languageVersion = "ova-certified-v1";
  attr String[1] certificationProfile = "OCL_VAL_FINITE_SET_V1";
  val Invariant[*] invariants;
}

class Invariant {
  id attr String[1] invariantId;
  attr String[1] name;
  attr String[1] contextClassName;
  attr AlgebraStage[1] stage = "SEMANTIC";

  val VariableDeclaration[1] selfVariable;
  val Expression[1] predicate;
}

class TypeDescriptor {
  attr TypeKind[1] kind;
  attr String typeName;
  attr CollectionKind[1] collectionKind = "NONE";

  val TypeDescriptor elementType;
}

class VariableDeclaration {
  id attr String[1] symbolId;
  attr String[1] name;
  val TypeDescriptor[1] declaredType;
}

abstract class Expression {
  id attr String[1] nodeId;
  val TypeDescriptor[1] resultType;
}

class VariableExpression extends Expression {
  ref VariableDeclaration[1] declaration;
}

class LiteralExpression extends Expression {
  attr LiteralKind[1] kind;
  attr String lexicalValue;
}

class SetExpression extends Expression {
  val Expression[*] elements;
}

class UnaryExpression extends Expression {
  attr UnaryOperator[1] operator;
  val Expression[1] operand;
}

class BinaryExpression extends Expression {
  attr BinaryOperator[1] operator;
  val Expression[1] left;
  val Expression[1] right;
}

class IfExpression extends Expression {
  val Expression[1] condition;
  val Expression[1] thenBranch;
  val Expression[1] elseBranch;
}

class LetExpression extends Expression {
  val VariableDeclaration[1] declaration;
  val Expression[1] value;
  val Expression[1] body;
}

class AttributeReference {
  attr String[1] ownerClassName;
  attr String[1] attributeName;
  val TypeDescriptor[1] declaredType;
}

class AttributeAccessExpression extends Expression {
  val Expression[1] source;
  val AttributeReference[1] attribute;
}

class NavigationReference {
  attr String[1] associationName;
  attr String[1] roleName;
  attr String[1] sourceClassName;
  attr String[1] targetClassName;
  attr String sourceRole;
  attr String targetRole;
  attr NavigationDirection[1] direction;
  attr boolean qualified = false;
}

class NavigationAccessExpression extends Expression {
  val Expression[1] source;
  val NavigationReference[1] navigation;
  val Expression[*] qualifiers;
}

class CallExpression extends Expression {
  attr CallKind[1] callKind;
  attr String[1] operationName;
  val Expression[1] source;
  val Expression[*] arguments;
}

class IteratorExpression extends Expression {
  attr IteratorKind[1] kind;
  val Expression[1] source;
  val VariableDeclaration[1] iterator;
  val Expression[1] body;
}

class NavigationPredicateExpression extends Expression {
  attr NavigationPredicateKind[1] kind;
  val NavigationAccessExpression[1] navigation;
  val VariableDeclaration iterator;
  val Expression predicate;
}

class NavigationCountExpression extends Expression {
  attr BinaryOperator[1] comparisonOperator;
  attr long[1] literal;
  val NavigationAccessExpression[1] navigation;
  val VariableDeclaration iterator;
  val Expression predicate;
}

class NavigationUniquenessExpression extends Expression {
  val NavigationAccessExpression[1] navigation;
  val VariableDeclaration[1] iterator;
  val Expression predicate;
  val Expression[1] projection;
}
