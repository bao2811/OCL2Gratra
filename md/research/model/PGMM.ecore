<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="pgmm"
    nsURI="https://uet-dse.org/pgmm/canonical/1.0"
    nsPrefix="pgmm">

  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="Generated normative PGMM-CANONICAL-1 artifact for the canonical UML-to-property-graph storage and certification profile. Its editable source is PGMM.emf. PGMM-Core.emf is only a non-normative paper-diagram projection. Traceability is defined by transformation functions and canonical keys, not by trace metaclasses."/>
  </eAnnotations>

  <!-- Enumerations -->
  <eClassifiers xsi:type="ecore:EEnum" name="GraphProjection">
    <eLiterals name="M2_SCHEMA" value="0"/>
    <eLiterals name="M1_INSTANCE" value="1"/>
    <eLiterals name="TYPING" value="2"/>
    <eLiterals name="REPOSITORY_CONTROL" value="3"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="Direction">
    <eLiterals name="OUTGOING" value="0"/>
    <eLiterals name="INCOMING" value="1"/>
    <eLiterals name="UNDIRECTED" value="2"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="AggregationKind">
    <eLiterals name="NONE" value="0"/>
    <eLiterals name="SHARED" value="1"/>
    <eLiterals name="COMPOSITE" value="2"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="PGType">
    <eLiterals name="STRING" value="0"/>
    <eLiterals name="BOOLEAN" value="1"/>
    <eLiterals name="INT64" value="2"/>
    <eLiterals name="REAL64" value="3"/>
    <eLiterals name="STRING_LIST" value="4"/>
    <eLiterals name="INTEGER" value="5"/>
    <eLiterals name="NODE_REFERENCE" value="6"/>
    <eLiterals name="RELATIONSHIP_REFERENCE" value="7"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="ProofStatus">
    <eLiterals name="CERTIFIED" value="0"/>
    <eLiterals name="IMPLEMENTED_UNCERTIFIED" value="1"/>
    <eLiterals name="EXCLUDED" value="2"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="AccessorKind">
    <eLiterals name="CONTEXT" value="0"/>
    <eLiterals name="ALL_INSTANCES" value="1"/>
    <eLiterals name="DIRECT_TYPE" value="2"/>
    <eLiterals name="CONFORMANCE" value="3"/>
    <eLiterals name="ATTRIBUTE" value="4"/>
    <eLiterals name="NAVIGATION" value="5"/>
    <eLiterals name="OBJECT_IDENTITY" value="6"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="ResultKind">
    <eLiterals name="SCALAR" value="0"/>
    <eLiterals name="PREDICATE" value="1"/>
    <eLiterals name="SET" value="2"/>
    <eLiterals name="INVARIANT_IDS" value="3"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="ConstraintSeverity">
    <eLiterals name="ERROR" value="0"/>
    <eLiterals name="WARNING" value="1"/>
    <eLiterals name="INFO" value="2"/>
  </eClassifiers>

  <!-- Common named element -->
  <eClassifiers xsi:type="ecore:EClass" name="NamedElement" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="documentation"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- PGMM root -->
  <eClassifiers xsi:type="ecore:EClass" name="PGSpecification" eSuperTypes="#//NamedElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="profileId" lowerBound="1"
        defaultValueLiteral="canonical-v1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="schemaVersion" lowerBound="1"
        defaultValueLiteral="canonical-v7.2-typed-scalars-model-isolation"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="proofStatus" lowerBound="1"
        defaultValueLiteral="CERTIFIED" eType="#//ProofStatus"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="modelScope" lowerBound="1"
        containment="true" eType="#//ModelScope"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="nodeTypes" upperBound="-1"
        containment="true" eType="#//NodeType"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="relationshipTypes" upperBound="-1"
        containment="true" eType="#//RelationshipType"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="keyDefinitions" upperBound="-1"
        containment="true" eType="#//KeyDefinition"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="codecDefinitions" upperBound="-1"
        containment="true" eType="#//CodecDefinition"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="accessorDefinitions" upperBound="-1"
        containment="true" eType="#//AccessorDefinition"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="wfConstraints" upperBound="-1"
        containment="true" eType="#//WFConstraint"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ModelScope">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="modelName" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="modelKey" lowerBound="1" iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="keyDelimiter" lowerBound="1"
        defaultValueLiteral="::"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Graph element definitions -->
  <eClassifiers xsi:type="ecore:EClass" name="GraphElementType" abstract="true"
      eSuperTypes="#//NamedElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="projection" lowerBound="1"
        eType="#//GraphProjection"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="proofStatus" lowerBound="1"
        defaultValueLiteral="IMPLEMENTED_UNCERTIFIED" eType="#//ProofStatus"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="properties" upperBound="-1"
        containment="true" eType="#//PropertyDefinition"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="NodeType" eSuperTypes="#//GraphElementType">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="labels" lowerBound="1" upperBound="-1"
        unique="true" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dynamicLabelsAllowed"
        defaultValueLiteral="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="RelationshipType" eSuperTypes="#//GraphElementType">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="physicalTypes" lowerBound="1"
        upperBound="-1" unique="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="direction" lowerBound="1"
        defaultValueLiteral="OUTGOING" eType="#//Direction"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="setSemantics"
        defaultValueLiteral="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sourceEnd" lowerBound="1"
        containment="true" eType="#//RelationshipEnd"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="targetEnd" lowerBound="1"
        containment="true" eType="#//RelationshipEnd"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="RelationshipEnd" eSuperTypes="#//NamedElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="roleName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lower" lowerBound="1"
        defaultValueLiteral="0"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="upper" lowerBound="1"
        defaultValueLiteral="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ordered"
        defaultValueLiteral="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="unique"
        defaultValueLiteral="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="aggregation" lowerBound="1"
        defaultValueLiteral="NONE" eType="#//AggregationKind"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="nodeType" lowerBound="1"
        eType="#//NodeType"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="qualifiers" upperBound="-1"
        containment="true" ordered="true" eType="#//QualifierDefinition"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="QualifierDefinition" eSuperTypes="#//NamedElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="index" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="sourceType" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="physicalProperty" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="codec" lowerBound="1"
        eType="#//CodecDefinition"/>
  </eClassifiers>

  <!-- Properties, keys, and codecs -->
  <eClassifiers xsi:type="ecore:EClass" name="PropertyDefinition" eSuperTypes="#//NamedElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="physicalName" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="valueType" lowerBound="1"
        eType="#//PGType"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="required"
        defaultValueLiteral="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="multiValued"
        defaultValueLiteral="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="defaultValue"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="codec"
        eType="#//CodecDefinition"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="KeyDefinition" eSuperTypes="#//NamedElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="unique" lowerBound="1"
        defaultValueLiteral="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="modelScoped"
        defaultValueLiteral="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="constructionExpression" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownerType" lowerBound="1"
        eType="#//GraphElementType"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="components" lowerBound="1"
        upperBound="-1" ordered="true" eType="#//PropertyDefinition"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="CodecDefinition" eSuperTypes="#//NamedElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="codecId" lowerBound="1" iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="sourceType" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="storageType" lowerBound="1"
        eType="#//PGType"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="bottomToken"
        defaultValueLiteral="v1|V"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="valuePrefix"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="injective" lowerBound="1"
        defaultValueLiteral="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="decodeExpression" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Compiler-visible graph accessors -->
  <eClassifiers xsi:type="ecore:EClass" name="AccessorDefinition" eSuperTypes="#//NamedElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1"
        eType="#//AccessorKind"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="resultKind" lowerBound="1"
        eType="#//ResultKind"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cypherTemplate" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="setSemantics"
        defaultValueLiteral="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="bottomSafe"
        defaultValueLiteral="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="proofStatus" lowerBound="1"
        defaultValueLiteral="IMPLEMENTED_UNCERTIFIED" eType="#//ProofStatus"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="nodeTypes" upperBound="-1"
        eType="#//NodeType"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="relationshipTypes" upperBound="-1"
        eType="#//RelationshipType"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="requiredProperties" upperBound="-1"
        eType="#//PropertyDefinition"/>
  </eClassifiers>

  <!-- Declarative well-formedness constraints -->
  <eClassifiers xsi:type="ecore:EClass" name="WFConstraint" eSuperTypes="#//NamedElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="constraintId" lowerBound="1" iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="severity" lowerBound="1"
        defaultValueLiteral="ERROR" eType="#//ConstraintSeverity"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="expressionLanguage" lowerBound="1"
        defaultValueLiteral="OCL"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="expression" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="proofStatus" lowerBound="1"
        defaultValueLiteral="IMPLEMENTED_UNCERTIFIED" eType="#//ProofStatus"/>
  </eClassifiers>

</ecore:EPackage>
